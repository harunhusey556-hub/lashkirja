{
  "name": "app",
  "version": "0.9.4",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parsers": "tsx scripts/test-parsers.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:viewport": "playwright test tests/e2e/viewport.spec.ts",
    "test:e2e:ci": "playwright test tests/e2e/viewport.spec.ts && playwright test tests/e2e/app.spec.ts --project=mobile-chromium --grep \"protected pages redirect to login|login lands on the dashboard and the tab bar navigates|a bank account can be added and a month reconciled|a rejected IBAN never reaches the server|privacy request status is visible and the lock PIN is masked\"",
    "build:mobile": "tsx scripts/build-mobile.ts",
    "test:e2e:mobile": "playwright test -c playwright.mobile.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:ipa": "bash scripts/build-ios-ipa.sh",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.6.5",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.48.0",
    "mailparser": "^3.9.14",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.5",
    "uuid": "^14.0.1",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
