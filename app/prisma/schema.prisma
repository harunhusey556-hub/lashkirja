generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  firstName     String
  lastName      String
  entityType    String      @default("toiminimi") // "kevytyrittaja" | "toiminimi"
  vatRegistered Boolean     @default(false)
  vatPeriod     String      @default("month") // "month" | "quarter" | "year"
  onboarded     Boolean     @default(false)
  businessDetails String?
  createdAt     DateTime    @default(now())
  receipts      Receipt[]
  statements    Statement[]
  uploads       Upload[]
  imapAccounts  ImapAccount[]
  chatMessages  ChatMessage[]
  bankAccounts  BankAccount[]
}

model Receipt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  vendor           String?
  date             DateTime?
  totalAmountCents Int?
  vatDetails       String?
  category         String?
  notes            String?
  type             String    @default("meno")
  reference        String? // viitenumero
  invoiceNumber    String? // laskun numero
  filePath         String
  fileName         String
  source           String    @default("manual")
  confidence       Float?
  rawText          String?
  reviewStatus     String    @default("approved")
  // Bank row this receipt was drafted from (auto_income). Unique so repeated
  // generation runs cannot produce a second draft for the same transaction.
  // Not a relation: the draft must survive its statement being deleted.
  sourceTransactionId String? @unique
  uploadId         String?   @unique
  upload           Upload?   @relation("ReceiptUpload", fields: [uploadId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  linkedTransaction     Transaction?     @relation("ConfirmedMatch")
  suggestedTransactions Transaction[]    @relation("SuggestedMatch")
  rejections            MatchRejection[]

  @@index([userId, date])
  @@index([userId, createdAt])
}

model Statement {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  // Which of the user's bank accounts this statement belongs to. Optional so
  // statements imported before multi-account support keep working; the UI
  // asks the user to assign them.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  fileName     String
  fileType     String
  filePath     String
  checksum     String?
  periodMonth  String? // "YYYY-MM"
  periodSource String        @default("auto") // "auto" | "manual"
  uploadedAt   DateTime      @default(now())
  transactions Transaction[]

  @@unique([userId, checksum])
  @@index([userId, periodMonth])
  @@index([userId, uploadedAt])
  @@index([bankAccountId, periodMonth])
}

model Transaction {
  id           String    @id @default(uuid())
  statementId  String
  statement    Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date         DateTime?
  counterparty String?
  amountCents  Int
  reference    String?
  message      String?
  type         String    @default("meno")
  createdAt    DateTime  @default(now())

  // Confirmed link only — a suggestion never occupies this FK
  receiptId          String?  @unique
  receipt            Receipt? @relation("ConfirmedMatch", fields: [receiptId], references: [id], onDelete: SetNull)
  suggestedReceiptId String?
  suggestedReceipt   Receipt? @relation("SuggestedMatch", fields: [suggestedReceiptId], references: [id], onDelete: SetNull)
  matchStatus        String   @default("unmatched") // "unmatched" | "suggested" | "confirmed" | "ignored"
  matchScore         Float?
  matchReasons       String? // JSON array, e.g. ["viite","amount"]

  rejections MatchRejection[]

  @@index([statementId, date])
  @@index([statementId, matchStatus])
  @@index([suggestedReceiptId])
}

model Upload {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose          String
  storageKey       String    @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  extractedJson    String?
  extractionSource String?
  confidence       Float?
  rawText          String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  claimedAt        DateTime?
  receipt          Receipt?  @relation("ReceiptUpload")

  @@unique([userId, sha256, purpose])
  @@index([userId, purpose, claimedAt])
  @@index([expiresAt])
}

// Rejection is per pair: rejecting one candidate must not block the
// transaction from matching a different receipt.
model MatchRejection {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receiptId     String
  receipt       Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, receiptId])
}

model ImapAccount {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  host           String    @default("imap.gmail.com")
  port           Int       @default(993)
  tls            Boolean   @default(true)
  encryptedPass  String
  lastSyncAt     DateTime? 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ChatMessage {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String    // "user" | "assistant"
  content        String
  proposalData   String?   // JSON representation of proposed match or action
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}


// A bank account the user owns. Balances are tracked per account so a user
// with several banks sees each account's own month-end position instead of
// one merged number.
model BankAccount {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  bankName            String?
  // Normalised (uppercase, no spaces). Nullable because a user may track a
  // cash account. SQLite treats NULLs as distinct, so several accounts may
  // have no IBAN while real IBANs stay unique per user.
  iban                String?
  bic                 String?
  currency            String   @default("EUR")
  // The known balance at the start of openingDate. Every later month rolls
  // forward from here.
  openingBalanceCents Int      @default(0)
  openingDate         DateTime
  isDefault           Boolean  @default(false)
  archivedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  statements      Statement[]
  monthlyBalances MonthlyBalance[]

  @@unique([userId, iban])
  @@index([userId, archivedAt])
}

// The balance the bank itself reports at the end of a month. Kept separate
// from the computed rollforward so a mismatch is visible instead of silently
// overwritten - that difference is the whole point of reconciliation.
model MonthlyBalance {
  id                  String      @id @default(uuid())
  bankAccountId       String
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  month               String // "YYYY-MM"
  closingBalanceCents Int
  source              String      @default("manual") // "manual" | "statement"
  note                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([bankAccountId, month])
  @@index([bankAccountId, month])
}
