generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  firstName     String
  lastName      String
  entityType    String      @default("toiminimi") // "toiminimi" | "kevytyrittaja" | "oy"
  vatRegistered Boolean     @default(false)
  vatPeriod     String      @default("month") // "month" | "quarter" | "year"
  onboarded     Boolean     @default(false)
  businessDetails String?
  // Seller details printed on an invoice. Explicit columns rather than JSON:
  // an invoice is a legal document, so these are validated and queryable.
  businessName      String?
  businessId        String? // Y-tunnus
  addressStreet     String?
  addressPostalCode String?
  addressCity       String?
  phone             String?
  invoiceIban       String?
  invoiceBic        String?
  invoiceTerms      String?
  // Late payment interest the user is entitled to charge (annual %). Null
  // means "do not charge": the Bank of Finland reference rate changes twice a
  // year, so a default baked into the app would be wrong half the time.
  lateInterestPercent Float?
  reminderFeeCents    Int     @default(500)
  /// New login email waiting for a confirmation link. The live email stays
  /// until that link is used.
  pendingEmail        String?
  /// Months up to and including this one are closed; nothing dated inside
  /// them may be created, edited or deleted. Format "YYYY-MM".
  booksLockedThrough  String?
  /// Set when every device must sign in again. Cookies sealed before session
  /// rows existed have no session id; this cutoff is what makes logout-all
  /// and a password reset refuse them.
  legacySessionsRevokedAt DateTime?
  /// Login and API sessions stop. Receipts and invoices stay for the
  /// accounting retention period. This is not a delete.
  accessDisabledAt DateTime?
  /// Card payments (Stripe Connect, Tap to Pay). The business's own connected
  /// account; the platform never holds the money (direct charges).
  stripeAccountId        String?  @unique
  /// Terminal Location created on the connected account.
  stripeLocationId       String?
  stripeChargesEnabled   Boolean  @default(false)
  stripePayoutsEnabled   Boolean  @default(false)
  stripeDetailsSubmitted Boolean  @default(false)
  /// The owner switched card payments on. Allowed only while charges are enabled.
  posEnabled             Boolean  @default(false)
  createdAt     DateTime    @default(now())
  receipts      Receipt[]
  statements    Statement[]
  uploads       Upload[]
  imapAccounts  ImapAccount[]
  chatMessages  ChatMessage[]
  bankAccounts  BankAccount[]
  bankConnections BankConnection[]
  customers     Customer[]
  salesInvoices SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  recurringInvoices RecurringInvoice[]
  recurringPurchases RecurringPurchase[]
  idempotencyRecords IdempotencyRecord[]
  invoiceSequence InvoiceSequence?
  catalogItems    CatalogItem[]
  backgroundJobs  BackgroundJob[]
  automationEvents AutomationEvent[]
  vendorCategoryRules VendorCategoryRule[]
  conversations Conversation[]
  authSessions    AuthSession[]
  accountTokens   AccountToken[]
  passkeys        PasskeyCredential[]
  accountRequests AccountRequest[]
  vatFilings      VatFiling[]
  invoiceEmailTemplates InvoiceEmailTemplate[]
  posPayments     PosPayment[]
  posRefunds      PosRefund[]
}

/// A browser or device that logged in. The iron-session cookie stores this id.
/// A row with revokedAt is dead even if the cookie is still presented.
model AuthSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

/// A WebAuthn passkey: an additional way to sign in. The password stays as
/// the fallback. `id` is the base64url credential id the authenticator chose.
model PasskeyCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// COSE public key bytes as returned by registration.
  publicKey  Bytes
  /// Signature counter (uint32). Apple passkeys always report 0.
  counter    BigInt    @default(0)
  /// JSON array of transport hints ("internal", "hybrid", ...), or null.
  transports String?
  deviceName String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// A WebAuthn ceremony challenge. Single use: verify deletes the row before
/// checking the response, so a replay finds nothing.
model PasskeyChallenge {
  id        String   @id @default(uuid())
  /// "register" | "authenticate"
  purpose   String
  challenge String
  /// Set for registration (the signed-in user); null for usernameless sign-in.
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One-time secret for a password reset or an email change. Only the hash is stored.
model AccountToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  payload   String?
  /// Password reset only: hash of the 6-digit code mailed with the link.
  codeHash     String?
  /// Wrong codes so far; the fifth one voids the row (link included).
  codeAttempts Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

/// A sign-up waiting for its emailed code. Not a User until the code is
/// verified; a new start for the same address replaces the row.
model PendingSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// A request to close the account, receive a copy of the books, or recover a
/// password when mail could not be sent. Records stay until the accounting
/// retention period is over; completing a close request disables access and
/// does not delete receipts or invoices.
/// status: pending | in_progress | needs_info | completed | denied
model AccountRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  status      String    @default("pending")
  note        String?
  /// Relative path under data/account-packages, set when an export is completed.
  packagePath String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, kind])
  @@index([status])
}

model Receipt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  vendor           String?
  date             DateTime?
  totalAmountCents Int?
  vatDetails       String?
  category         String?
  notes            String?
  type             String    @default("meno")
  reference        String? // viitenumero
  invoiceNumber    String? // laskun numero
  filePath         String
  fileName         String
  source           String    @default("manual")
  confidence       Float?
  rawText          String?
  reviewStatus     String    @default("approved")
  // Bank row this receipt was drafted from (auto_income). Unique so repeated
  // generation runs cannot produce a second draft for the same transaction.
  // Not a relation: the draft must survive its statement being deleted.
  sourceTransactionId String? @unique
  uploadId         String?   @unique
  upload           Upload?   @relation("ReceiptUpload", fields: [uploadId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  linkedTransaction     Transaction?     @relation("ConfirmedMatch")
  suggestedTransactions Transaction[]    @relation("SuggestedMatch")
  rejections            MatchRejection[]
  purchaseInvoice       PurchaseInvoice?

  @@index([userId, date])
  @@index([userId, createdAt])
}

model Statement {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  // Which of the user's bank accounts this statement belongs to. Optional so
  // statements imported before multi-account support keep working; the UI
  // asks the user to assign them.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  fileName     String
  fileType     String
  filePath     String
  checksum     String?
  periodMonth  String? // "YYYY-MM"
  periodSource String        @default("auto") // "auto" | "manual"
  uploadedAt   DateTime      @default(now())
  transactions Transaction[]

  @@unique([userId, checksum])
  @@index([userId, periodMonth])
  @@index([userId, uploadedAt])
  @@index([bankAccountId, periodMonth])
}

model Transaction {
  id           String    @id @default(uuid())
  statementId  String
  statement    Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date         DateTime?
  counterparty String?
  amountCents  Int
  reference    String?
  message      String?
  type         String    @default("meno")
  createdAt    DateTime  @default(now())

  // Confirmed link only — a suggestion never occupies this FK
  receiptId          String?  @unique
  receipt            Receipt? @relation("ConfirmedMatch", fields: [receiptId], references: [id], onDelete: SetNull)
  suggestedReceiptId String?
  suggestedReceipt   Receipt? @relation("SuggestedMatch", fields: [suggestedReceiptId], references: [id], onDelete: SetNull)
  matchStatus        String   @default("unmatched") // "unmatched" | "suggested" | "confirmed" | "ignored"
  matchScore         Float?
  matchReasons       String? // JSON array, e.g. ["viite","amount"]

  rejections MatchRejection[]
  // Set when this bank row settles a sales invoice.
  invoicePayment InvoicePayment?
  // Set when this bank row settles a purchase invoice.
  purchasePayment PurchasePayment?
  // Set when the owner deleted the sale draft made from this row.
  incomeDraftDismissal IncomeDraftDismissal?

  // Denormalized for Enable Banking dedupe. File imports may leave bankRef null.
  userId  String?
  bankRef String?
  source  String  @default("file") // "file" | "enablebanking"
  iban    String?

  @@index([statementId, date])
  @@index([statementId, matchStatus])
  @@index([suggestedReceiptId])
  @@unique([userId, bankRef])
  @@index([userId, source])
}

// The owner deleted the sale draft that was made from a bank row: the row does
// not get another one. Without this the row, back to "unmatched", qualified for
// a fresh draft on the next matching run.
model IncomeDraftDismissal {
  transactionId String      @id
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Upload {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose          String
  storageKey       String    @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  extractedJson    String?
  extractionSource String?
  confidence       Float?
  rawText          String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  claimedAt        DateTime?
  receipt          Receipt?  @relation("ReceiptUpload")

  @@unique([userId, sha256, purpose])
  @@index([userId, purpose, claimedAt])
  @@index([expiresAt])
}

/// Work that must outlive the HTTP request: OCR, bank sync, email scan.
model BackgroundJob {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String // "document_analysis" | "bank_sync" | "email_scan"
  status        String    @default("pending") // "pending" | "running" | "failed" | "done" | "cancelled"
  title         String
  detail        String?
  error         String?
  progressLabel String?
  resourceType  String?
  resourceId    String?
  payload       String?
  /// Ownership of the current attempt. A cancel or retry clears it so a
  /// run that is still in OCR cannot write the result.
  attemptToken  String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([kind, status])
}

/// Previous value, new value, and why an automation changed a match or category.
model AutomationEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String // "match" | "category" | "link_error"
  resourceType  String
  resourceId    String
  previousValue String?
  newValue      String?
  reason        String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind])
}

/// Explicit vendor → category rule. A correction never creates one by itself.
model VendorCategoryRule {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    String
  category  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  @@unique([userId, vendor])
  @@index([userId, active])
}

// Rejection is per pair: rejecting one candidate must not block the
// transaction from matching a different receipt.
model MatchRejection {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receiptId     String
  receipt       Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, receiptId])
}

model ImapAccount {
  id             String    @id @default(uuid())
  // Outgoing settings live with the account that already holds the password.
  // Null means "derive from the IMAP host", which is right for the common
  // providers (imap.gmail.com -> smtp.gmail.com).
  smtpHost       String?
  smtpPort       Int?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  host           String    @default("imap.gmail.com")
  port           Int       @default(993)
  tls            Boolean   @default(true)
  encryptedPass  String
  lastSyncAt     DateTime? 
  /// When the mailbox was last read, by "Tarkista nyt" or the background run; lastSyncAt is the newest mail seen.
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A persisted chat thread. "Uusi keskustelu" creates one of these; it is not
// a client-side date cutoff.
model Conversation {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String    @default("Uusi keskustelu")
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String    // "user" | "assistant"
  content        String
  proposalData   String?   // JSON representation of proposed match or action
  // Client retry key. A repeated send with the same id returns the saved turn.
  clientId       String?   @unique
  // The user message this assistant reply answers. One reply row per question;
  // a retry updates that row instead of inserting another.
  replyToId      String?   @unique
  replyTo        ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("ChatReply")
  // streaming | complete | cancelled | failed | incomplete
  status         String    @default("complete")
  // In-flight owner. A second retry cannot take a fresh streaming row.
  replyOwner     String?
  ownerHeartbeat DateTime?
  // JSON [{ label, href }] for figures taken from the user's books.
  sources        String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt, id])
}

// PSD2 AIS consent. sessionIdEnc is the Enable Banking session id at rest.
// It is never returned to the browser. This is not a ledger BankAccount:
// month-end balances stay on BankAccount, synced ASPSP accounts stay here.
model BankConnection {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  aspspName          String
  aspspCountry       String
  aspspLogo          String?
  psuType            String // "personal" | "business"
  status             String             @default("pending") // pending|authorizing|active|expired|revoked|error
  authStateHash      String?
  sessionIdEnc       String?
  validUntil         DateTime?
  requiredPsuHeaders String?
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  /// "YYYY-MM-DD": the first sync fetches from this day. Null = all the bank allows.
  historyFrom        String?
  /// How far back, in days, the bank gives transactions, when known. Enable
  /// Banking's ASPSP data does not say, so it is learned when the bank refuses
  /// an older start and answers a shorter window. Null = unknown.
  historyLimitDays   Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  accounts           ConnectedAccount[]

  @@index([userId, status])
  @@index([status, lastSyncAt])
  @@index([authStateHash])
}

// Accounts returned by a PSD2 consent. New rows stay out of bookkeeping
// until the user opts in. A business consent can return IBANs that belong
// to other companies.
model ConnectedAccount {
  id                 String         @id @default(uuid())
  userId             String
  connectionId       String
  connection         BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  iban               String
  label              String?
  currency           String         @default("EUR")
  providerAccountUid String
  inScope            Boolean        @default(false)
  balanceCents       Int?
  balanceAt          DateTime?
  /// "YYYY-MM-DD": the earliest day this account's history has been asked
  /// from (and answered). A connection historyFrom before it makes the next
  /// sync read the older window. Null = not recorded yet.
  historyFrom        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([connectionId, providerAccountUid])
  @@index([userId, iban])
  @@map("ConnectedAccount")
}


// A bank account the user owns. Balances are tracked per account so a user
// with several banks sees each account's own month-end position instead of
// one merged number.
model BankAccount {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  bankName            String?
  // Normalised (uppercase, no spaces). Nullable because a user may track a
  // cash account. SQLite treats NULLs as distinct, so several accounts may
  // have no IBAN while real IBANs stay unique per user.
  iban                String?
  bic                 String?
  currency            String   @default("EUR")
  // The known balance at the start of openingDate. Every later month rolls
  // forward from here.
  openingBalanceCents Int      @default(0)
  openingDate         DateTime
  isDefault           Boolean  @default(false)
  archivedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  statements      Statement[]
  monthlyBalances MonthlyBalance[]

  @@unique([userId, iban])
  @@index([userId, archivedAt])
}

// The balance the bank itself reports at the end of a month. Kept separate
// from the computed rollforward so a mismatch is visible instead of silently
// overwritten - that difference is the whole point of reconciliation.
model MonthlyBalance {
  id                  String      @id @default(uuid())
  bankAccountId       String
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  month               String // "YYYY-MM"
  closingBalanceCents Int
  source              String      @default("manual") // "manual" | "statement"
  note                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([bankAccountId, month])
  @@index([bankAccountId, month])
}

// A person or company the user invoices. Kept per user; two users may hold the
// same customer without seeing each other's rows.
model Customer {
  id                     String    @id @default(uuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  businessId             String? // Y-tunnus, validated before it is stored
  contactPerson          String?
  email                  String?
  phone                  String?
  addressStreet          String?
  addressPostalCode      String?
  addressCity            String?
  country                String    @default("FI")
  defaultPaymentTermDays Int       @default(14)
  notes                  String?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  invoices          SalesInvoice[]
  recurringInvoices RecurringInvoice[]

  @@index([userId, archivedAt])
  @@index([userId, name])
}

// Sales invoice. Totals are stored alongside the lines: the lines are the
// source of truth while the invoice is a draft, and the stored totals are what
// was actually sent to the customer once it leaves draft.
model SalesInvoice {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  number     Int
  reference  String // viitenumero with its check digit
  issueDate  DateTime
  dueDate    DateTime
  status     String    @default("draft") // draft | sent | paid | credited
  sentAt     DateTime?
  paidAt     DateTime?
  notes      String?
  currency   String    @default("EUR")
  netCents   Int       @default(0)
  vatCents   Int       @default(0)
  grossCents Int       @default(0)
  /// Seller and customer block printed on the PDF, frozen when the invoice
  /// leaves draft. Later profile or customer edits must not rewrite it.
  partySnapshot String?
  /// Held from the moment a send starts until SMTP fails or the outcome is
  /// stored. Edits must not land while this is set.
  sendLockToken String?
  sendLockAt    DateTime?
  /// sha256 of the PDF that was actually sent, plus the document it was
  /// built from. A later draft edit must not change these.
  sentContentHash      String?
  sentDocumentSnapshot String?
  /// Set only by an explicit close that is not covered by payments.
  closedReason  String?
  closedAt      DateTime?
  /// invoice | credit_note. A credit note is its own document, not a status.
  documentKind     String  @default("invoice")
  /// The invoice this credit note corrects. Null on ordinary invoices.
  creditsInvoiceId String?
  creditsInvoice   SalesInvoice?  @relation("InvoiceCredit", fields: [creditsInvoiceId], references: [id], onDelete: SetNull)
  creditNotes      SalesInvoice[] @relation("InvoiceCredit")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lines        InvoiceLine[]
  payments     InvoicePayment[]
  reminders    InvoiceReminder[]
  emailSends   InvoiceEmailSend[]
  activities   InvoiceActivity[]
  recurringRun RecurringInvoiceRun?
  posPayments  PosPayment[]

  @@unique([userId, number])
  @@unique([userId, reference])
  @@index([userId, status, dueDate])
  @@index([customerId, issueDate])
  @@index([creditsInvoiceId])
}

model InvoiceLine {
  id              String       @id @default(uuid())
  invoiceId       String
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder       Int          @default(0)
  description     String
  quantityMilli   Int // thousandths of a unit
  unit            String       @default("kpl")
  unitPriceCents  Int
  vatRatePermille Int          @default(255)
  netCents        Int

  @@index([invoiceId, sortOrder])
}

// A payment against an invoice. transactionId is unique so the same bank row
// can never be counted towards two invoices.
model InvoicePayment {
  id            String       @id @default(uuid())
  invoiceId     String
  invoice       SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String?      @unique
  // Losing the bank row must not erase the fact that the customer paid.
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  paidDate      DateTime
  amountCents   Int
  source        String       @default("manual") // "manual" | "bank" | "stripe_terminal"
  note          String?
  /// The verified card payment this row books. Unique: one card payment is
  /// booked at most once, however many times finalize and the webhook run.
  posPaymentId  String?      @unique
  posPayment    PosPayment?  @relation(fields: [posPaymentId], references: [id], onDelete: SetNull)
  /// Set on the correction row of a card refund made after the payment's month was locked.
  posRefundCorrection PosRefund? @relation("PosRefundCorrection")
  createdAt     DateTime     @default(now())

  @@index([invoiceId])
}

/// One Stripe refund of a booked live card payment, once per Stripe refund id
/// (unique), however many times the app, its retry and the webhook report it.
/// books: "applied" (the payment's month was open: the invoice payment shrank),
/// "correction_pending" (the month was locked: a card in Huomioitavat waits for
/// the owner) or "corrected" (accepted: a negative card payment row was posted
/// in the first open month; the locked month is never changed).
model PosRefund {
  id                  String          @id @default(uuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posPaymentId        String
  posPayment          PosPayment      @relation(fields: [posPaymentId], references: [id], onDelete: Cascade)
  stripeRefundId      String          @unique
  amountCents         Int
  /// When Stripe made the refund (refund.created).
  refundedAt          DateTime
  books               String
  correctionPaymentId String?         @unique
  correctionPayment   InvoicePayment? @relation("PosRefundCorrection", fields: [correctionPaymentId], references: [id], onDelete: SetNull)
  correctedAt         DateTime?
  createdAt           DateTime        @default(now())

  @@index([userId, books])
  @@index([posPaymentId])
}

/// A card payment taken on the phone (Stripe Terminal, Tap to Pay) on the
/// business's own connected account. Amounts in integer cents.
model PosPayment {
  id                      String          @id @default(uuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId               String?
  invoice                 SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider                String          @default("stripe")
  providerPaymentIntentId String          @unique
  providerChargeId        String?
  amountCents             Int
  currency                String          @default("EUR")
  /// created | processing | succeeded | failed | canceled | refunded | partially_refunded
  status                  String          @default("created")
  refundedCents           Int             @default(0)
  cardBrand               String?
  cardLast4               String?
  failureCode             String?
  failureMessage          String?
  idempotencyKey          String?
  /// Stripe's livemode of the PaymentIntent (re-checked on every read from
  /// Stripe). Booked on the invoice only when true AND the server key is live;
  /// a test payment never creates an InvoicePayment.
  livemode                Boolean         @default(false)
  createdAt               DateTime        @default(now())
  /// Set when Stripe confirmed the payment; for a live payment in the same
  /// transaction that books the InvoicePayment.
  succeededAt             DateTime?
  refundedAt              DateTime?
  /// Last time the worker's reconcile asked Stripe about this payment.
  reconciledAt            DateTime?
  invoicePayment          InvoicePayment?
  refunds                 PosRefund[]

  @@index([userId, createdAt])
  @@index([invoiceId])
  @@index([status, createdAt])
}

// A supplier invoice the user owes. Deliberately a payables tracker only: the
// VAT return keeps taking its numbers from receipts, so an invoice recorded
// here and a receipt for the same purchase cannot double-count each other.
// Attach the receipt with receiptId once it arrives.
model PurchaseInvoice {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierName       String
  supplierBusinessId String?
  supplierIban       String?
  invoiceNumber      String?
  reference          String? // viitenumero, used for bank matching
  issueDate          DateTime
  dueDate            DateTime
  status             String    @default("open") // open | paid | cancelled
  grossCents         Int
  vatCents           Int       @default(0)
  netCents           Int       @default(0)
  category           String?
  notes              String?
  paidAt             DateTime?
  /// Set only by an explicit close that is not covered by payments.
  closedReason       String?
  closedAt           DateTime?
  // The receipt that documents this purchase, once it exists.
  receiptId          String?   @unique
  receipt            Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  /// The recurring template (toistuva ostolasku) that created this invoice.
  recurringPurchaseId String?
  recurringPurchase   RecurringPurchase? @relation(fields: [recurringPurchaseId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments     PurchasePayment[]
  recurringRun RecurringPurchaseRun?

  @@index([userId, status, dueDate])
  @@index([userId, issueDate])
  @@index([recurringPurchaseId])
}

model PurchasePayment {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  transactionId     String?         @unique
  transaction       Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  paidDate          DateTime
  amountCents       Int
  source            String          @default("manual") // "manual" | "bank"
  note              String?
  createdAt         DateTime        @default(now())

  @@index([purchaseInvoiceId])
}

// One row per attempt to email a sales invoice. Written before SMTP so a
// later failure to update the invoice cannot pretend the message never left.
model InvoiceEmailSend {
  id            String       @id @default(uuid())
  invoiceId     String
  invoice       SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  toAddress     String
  subject       String
  /// pending: PDF is built, SMTP has not been called (a crash here is a safe
  /// resend). sending: SMTP was called and the outcome is not stored yet
  /// (ambiguous — do not send again). ambiguous: the server accepted the
  /// message and the invoice row could not be updated. sent | failed.
  status        String
  messageId     String?
  error         String?
  /// sha256 of the PDF bytes for this attempt.
  contentHash   String?
  /// Full document the PDF was built from (lines, totals, parties).
  documentSnapshot String?
  /// Parties that were rendered into the attachment, kept even if the invoice
  /// row itself could not be updated after the message was accepted.
  partySnapshot String?
  /// Filename of the PDF attached to this attempt.
  attachmentName String?
  /// Gross amount on that PDF, in cents, so history survives a later edit.
  grossCents     Int?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?

  @@index([invoiceId, createdAt])
}

// A payment reminder that was actually sent. Stored because what was demanded
// - principal, interest and fee on that day - has to stay reconstructible.
model InvoiceReminder {
  id                String       @id @default(uuid())
  invoiceId         String
  invoice           SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level             Int          @default(1)
  sentAt            DateTime     @default(now())
  sentTo            String?
  /// Due date printed on the reminder itself, not the invoice's own.
  dueDate           DateTime
  openCents         Int
  interestCents     Int
  feeCents          Int
  totalCents        Int
  annualRatePercent Float?
  daysLate          Int

  @@index([invoiceId, sentAt])
}

// A standing order to invoice the same customer on a schedule. The lines are a
// template: each generated invoice gets its own copy, so editing the template
// never rewrites an invoice the customer already holds.
model RecurringInvoice {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  name            String?
  interval        String // "monthly" | "quarterly" | "yearly"
  anchorDay       Int // day of month the invoice is issued on
  startDate       DateTime
  endDate         DateTime?
  /// Next issue date owed. Null once the schedule has finished.
  nextRunAt       DateTime?
  paymentTermDays Int       @default(14)
  notes           String?
  /// Email the invoice to the customer as soon as it is generated.
  autoSend        Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines RecurringInvoiceLine[]
  runs  RecurringInvoiceRun[]

  @@index([userId, active, nextRunAt])
  @@index([customerId])
}

model RecurringInvoiceLine {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  sortOrder          Int              @default(0)
  description        String
  quantityMilli      Int
  unit               String           @default("kpl")
  unitPriceCents     Int
  vatRatePermille    Int              @default(255)

  @@index([recurringInvoiceId, sortOrder])
}

// One occurrence. The unique (schedule, issueDate) pair is what makes
// generation idempotent: a second run on the same day cannot invoice twice.
model RecurringInvoiceRun {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  issueDate          DateTime
  invoiceId          String?          @unique
  invoice            SalesInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status             String           @default("created") // created | skipped_locked | failed
  note               String?
  createdAt          DateTime         @default(now())

  @@unique([recurringInvoiceId, issueDate])
  @@index([recurringInvoiceId, createdAt])
}

/// A routine expense (rent, a subscription) that becomes a purchase invoice
/// every period. Amounts follow the purchase invoice rules: VAT is derived from
/// the gross amount and the rate.
model RecurringPurchase {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierName       String
  supplierBusinessId String?
  supplierIban       String?
  reference          String?
  category           String?
  notes              String?
  grossCents         Int
  vatRate            Float // 0 | 10 | 13.5 | 14 | 25.5
  interval           String // "monthly" | "quarterly" | "yearly"
  dayOfMonth         Int // 1-28, the issue day
  dueDays            Int // 0-90, due date = issue date + dueDays
  startDate          DateTime
  endDate            DateTime?
  active             Boolean   @default(true)
  /// Next issue date owed.
  nextRunDate        DateTime
  lastRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  runs     RecurringPurchaseRun[]
  invoices PurchaseInvoice[]

  @@index([userId, active, nextRunDate])
}

/// One period of a recurring purchase. The unique key is what keeps a period
/// from being created twice.
model RecurringPurchaseRun {
  id                  String            @id @default(uuid())
  recurringPurchaseId String
  recurringPurchase   RecurringPurchase @relation(fields: [recurringPurchaseId], references: [id], onDelete: Cascade)
  periodKey           String // "YYYY-MM" of the issue date
  /// Null once the invoice is deleted: the period still counts as run.
  purchaseInvoiceId   String?           @unique
  purchaseInvoice     PurchaseInvoice?  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())

  @@unique([recurringPurchaseId, periodKey])
}

/// Replay of a create that the client already sent. The key is per user and
/// route, so a double tap cannot insert a second invoice, payment, or customer.
model IdempotencyRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String
  key        String
  statusCode Int
  body       String
  /// sha256 of the request body. A second call with the same key and a
  /// different hash is refused. Empty means the row predates the check.
  requestHash String   @default("")
  createdAt  DateTime @default(now())

  @@unique([userId, scope, key])
}

/// One row per user. nextNumber is the next integer to hand out. Deleting a
/// draft does not move it backwards, and a new calendar year does not reset it.
model InvoiceSequence {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nextNumber Int
}

/// Readable history on one invoice. Summaries are Finnish sentences, not dumps.
model InvoiceActivity {
  id        String       @id @default(uuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// created | amount_changed | payment_added | payment_removed | status_changed | sent | credit_issued | duplicated
  kind      String
  summary   String
  createdAt DateTime     @default(now())

  @@index([invoiceId, createdAt])
}

/// A line the user invoices often. Picking one fills an invoice row.
model CatalogItem {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  unit            String    @default("kpl")
  unitPriceCents  Int
  vatRatePermille Int       @default(255)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, archivedAt])
}

/// The owner's own record that a VAT return was filed in OmaVero and paid
/// (FP-13). LashKirja does not file anything itself; this is the finish line
/// the month close and Koti read. `period` is "YYYY-MM", "YYYY-Qn" or "YYYY".
model VatFiling {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  period           String
  filedAt          DateTime?
  /// Field 308 at the moment of filing, signed (negative = refund). A later
  /// difference means the books changed after the return was filed.
  filedAmountCents Int?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, period])
}

/// A saved e-mail text for sending an invoice ("Sähköpostimallit"). Subject and
/// body may carry placeholders ({asiakas}, {summa}, ...) that the server fills in
/// for each invoice. One default per user and kind; the default fills the send
/// sheet and is used when an invoice is sent without a text of its own.
model InvoiceEmailTemplate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  /// "invoice" | "reminder". Only invoice templates are applied today.
  kind      String   @default("invoice")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}
