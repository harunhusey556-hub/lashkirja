generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  firstName     String
  lastName      String
  entityType    String      @default("toiminimi") // "kevytyrittaja" | "toiminimi"
  vatRegistered Boolean     @default(false)
  vatPeriod     String      @default("month") // "month" | "quarter" | "year"
  createdAt     DateTime    @default(now())
  receipts        Receipt[]
  statements      Statement[]
  uploads         Upload[]
  imapAccounts    ImapAccount[]
  bankConnections BankConnection[]
}

model Receipt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  vendor           String?
  date             DateTime?
  totalAmountCents Int?
  vatDetails       String?
  category         String?
  notes            String?
  type             String    @default("meno")
  reference        String? // viitenumero
  invoiceNumber    String? // laskun numero
  filePath         String
  fileName         String
  source           String    @default("manual")
  confidence       Float?
  rawText          String?
  reviewStatus     String    @default("approved")
  uploadId         String?   @unique
  upload           Upload?   @relation("ReceiptUpload", fields: [uploadId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  linkedTransaction     Transaction?     @relation("ConfirmedMatch")
  suggestedTransactions Transaction[]    @relation("SuggestedMatch")
  rejections            MatchRejection[]

  @@index([userId, date])
  @@index([userId, createdAt])
}

model Statement {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  fileName     String
  fileType     String
  filePath     String
  checksum     String?
  periodMonth  String? // "YYYY-MM"
  periodSource String        @default("auto") // "auto" | "manual"
  uploadedAt   DateTime      @default(now())
  transactions Transaction[]

  @@unique([userId, checksum])
  @@index([userId, periodMonth])
  @@index([userId, uploadedAt])
}

model Transaction {
  id           String    @id @default(uuid())
  statementId  String
  statement    Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date         DateTime?
  counterparty String?
  amountCents  Int
  reference    String?
  message      String?
  type         String    @default("meno")
  createdAt    DateTime  @default(now())

  // Confirmed link only — a suggestion never occupies this FK
  receiptId          String?  @unique
  receipt            Receipt? @relation("ConfirmedMatch", fields: [receiptId], references: [id], onDelete: SetNull)
  suggestedReceiptId String?
  suggestedReceipt   Receipt? @relation("SuggestedMatch", fields: [suggestedReceiptId], references: [id], onDelete: SetNull)
  matchStatus        String   @default("unmatched") // "unmatched" | "suggested" | "confirmed" | "ignored"
  matchScore         Float?
  matchReasons       String? // JSON array, e.g. ["viite","amount"]

  rejections MatchRejection[]

  // Denormalized for dedupe. File imports may leave bankRef null.
  userId  String?
  bankRef String?
  source  String  @default("file") // "file" | "enablebanking"
  iban    String?

  @@unique([userId, bankRef])
  @@index([statementId, date])
  @@index([statementId, matchStatus])
  @@index([suggestedReceiptId])
  @@index([userId, source])
}

// PSD2 AIS consent. sessionIdEnc is the Enable Banking session id at rest.
// It is never returned to the browser.
model BankConnection {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aspspName          String
  aspspCountry       String
  aspspLogo          String?
  psuType            String // "personal" | "business"
  status             String        @default("pending") // pending|authorizing|active|expired|revoked|error
  authStateHash      String?
  sessionIdEnc       String?
  validUntil         DateTime?
  requiredPsuHeaders String?
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  accounts           BankAccount[]

  @@index([userId, status])
  @@index([status, lastSyncAt])
  @@index([authStateHash])
}

// New accounts stay out of bookkeeping until the user opts in.
// A business consent can return IBANs that belong to other companies.
model BankAccount {
  id                 String         @id @default(uuid())
  userId             String
  connectionId       String
  connection         BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  iban               String
  label              String?
  currency           String         @default("EUR")
  providerAccountUid String
  inScope            Boolean        @default(false)
  balanceCents       Int?
  balanceAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([connectionId, providerAccountUid])
  @@index([userId, iban])
}

model Upload {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose          String
  storageKey       String    @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  extractedJson    String?
  extractionSource String?
  confidence       Float?
  rawText          String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  claimedAt        DateTime?
  receipt          Receipt?  @relation("ReceiptUpload")

  @@unique([userId, sha256, purpose])
  @@index([userId, purpose, claimedAt])
  @@index([expiresAt])
}

// Rejection is per pair: rejecting one candidate must not block the
// transaction from matching a different receipt.
model MatchRejection {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receiptId     String
  receipt       Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, receiptId])
}

model ImapAccount {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  host           String    @default("imap.gmail.com")
  port           Int       @default(993)
  tls            Boolean   @default(true)
  encryptedPass  String
  lastSyncAt     DateTime? 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
