# SQLite. Relative to the app/ directory.
DATABASE_URL="file:../data/lashkirja.db"

# At least 32 characters in production.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional. Set true behind HTTPS.
# COOKIE_SECURE="true"
# APP_ORIGIN="https://lashkirja.example"

# Protects /api/cron/sync-email, /api/cron/cleanup, /api/cron/sync-bank
# and /api/cron/recurring-invoices. Bank cron rejects every request when this is empty.
CRON_SECRET="replace-with-a-long-random-string"

# json = invoice email is captured for tests and does not open SMTP.
# MAIL_TRANSPORT=""
# Password reset and email confirmation use that same invoice mailbox.
# If it is not connected, support mints a link with scripts/account-recovery.ts.
# See app/docs/account-recovery.md.

# --- Enable Banking (PSD2 AIS) ---
# Real Finnish banks (Holvi, Säästöpankki, …) need a Control Panel app.
# Sandbox and production apps are separate. Mock ASPSP is only for tests.
# Leave ENABLED false until the redirect URL, key and app id are set.
ENABLEBANKING_ENABLED="false"
ENABLEBANKING_APP_ID=""
# Private key stays outside the repo. Prefer a file path locally.
# The path may be absolute, or relative to the process working directory (app/).
ENABLEBANKING_KEY_FILE=""
# Deployments without a filesystem secret (for example Vercel) can set the PEM
# here instead: either the PEM text with escaped newlines, or standard base64 of the PEM.
# Never commit the value. Do not log it.
# ENABLEBANKING_KEY_PEM=""
# Must match a redirect URL whitelisted in the Enable Banking Control Panel, character for character.
ENABLEBANKING_REDIRECT_URL="http://localhost:3000/bank/callback"
# Production and sandbox both use this host. Override only if Enable Banking tells you to.
ENABLEBANKING_API_BASE="https://api.enablebanking.com"

# --- AI (receipts and the assistant) ---
# Tried in order: Copilot, then the OpenAI-compatible LLM below. A Copilot
# quota refusal (402/403/429) skips Copilot for an hour, so the LLM carries
# on when the free quota runs out. With neither set, receipts use local OCR
# and the assistant answers only what the books can answer exactly.
# COPILOT_GITHUB_TOKEN=""
# COPILOT_MODEL="gpt-4o"
# Any /chat/completions endpoint, e.g. Gemini:
#   https://generativelanguage.googleapis.com/v1beta/openai  (LLM_MODEL="gemini-3.1-flash-lite";
#   picked 2026-10-02: 20/20 on the receipt checks, exact VAT math, 500 requests/day on tier 1)
# or a local Ollama: http://127.0.0.1:11434/v1 (any non-empty LLM_API_KEY).
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# Optional stronger model for the assistant only; defaults to LLM_MODEL.
# LLM_CHAT_MODEL=""

# --- Behind Tailscale Funnel / a tunnel ---
# Rate limits key on the client IP from X-Forwarded-For only when this is
# true. Without it every user shares one bucket, and one person's failed
# logins can lock everyone out.
# TRUST_PROXY="true"
# Bearer token for GET /api/health. In production the endpoint answers 500
# until it is set. Any long random string.
# HEALTH_TOKEN=""

# Support address shown on Asetukset > Ohje ja tuki and used as the mail recipient.
# Set it at build time for the mobile app; when empty the page says plainly that no address is set.
# NEXT_PUBLIC_SUPPORT_EMAIL=""
